body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.main {
  flex: 1 0 auto;
}

.footer {
  flex-shrink: 0;
}

// Tag cloud: increase contrast so tags are clearly readable
.tag-cloud a {
  border-bottom: 1px solid transparent;
  color: var(--link-color);
  transition: color 0.2s ease-in-out, border-bottom-color 0.2s ease-in-out;
}

.tag-cloud a:hover {
  color: var(--link-hover-color);
  border-bottom-color: var(--link-hover-color);
}

.sidebar-inner.sidebar-overview-active {
  overflow: hidden;
}

.sidebar-toc-active .sidebar-music {
  display: none;
}

.sidebar {
  display: flex;
  flex-direction: column;
}

.sidebar-inner {
  flex: 1;
  min-height: 0;
}

@media (max-width: 767px) {
  .post-body {
    font-size: 16px;
    line-height: 1.8;
  }

  .post-body h1 { font-size: 1.6em; }
  .post-body h2 { font-size: 1.4em; }
  .post-body h3 { font-size: 1.2em; }

  .post-eof {
    display: none;
  }
}

// Sidebar panel: hide its own scrollbar
.sidebar-panel-container {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.sidebar-panel-container::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

@media (min-width: 992px) {
  .sidebar {
    max-height: calc(100vh - 24px);
  }
}

@media (max-width: 991px) {
  .sidebar-inner {
    flex: none;
  }
}

body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.main {
  flex: 1 0 auto;
}

.footer {
  flex-shrink: 0;
}

// Tag cloud: increase contrast so tags are clearly readable
.tag-cloud a {
  border-bottom: 1px solid transparent;
  color: var(--link-color);
  transition: color 0.2s ease-in-out, border-bottom-color 0.2s ease-in-out;
}

.tag-cloud a:hover {
  color: var(--link-hover-color);
  border-bottom-color: var(--link-hover-color);
}

.sidebar-inner.sidebar-overview-active {
  overflow: hidden;
}

.sidebar {
  display: flex;
  flex-direction: column;
}

.sidebar-inner {
  flex: 1;
  min-height: 0;
}

// Sidebar panel: hide its own scrollbar (content fits; wheel/touch scrolling still works)
.sidebar-panel-container {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.sidebar-panel-container::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
